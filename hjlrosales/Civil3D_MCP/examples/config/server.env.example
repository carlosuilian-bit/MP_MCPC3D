# Environment variables for Autodesk.MCP.Server.
# Precedence: defaults < configuration file < environment variables.
# Prefix the server with these, or set them in your shell profile / service manager.

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error | fatal
# export AUTODESK_MCP_LOG_LEVEL="debug"

# --- Discovery -------------------------------------------------------------
# Where bridge endpoint descriptors are scanned.
# export AUTODESK_MCP_ENDPOINTS_DIR="C:\Users\you\AppData\Local\AutodeskMcp\endpoints"

# Restrict discovery to a product / bridge name (multi-bridge setups).
# export AUTODESK_MCP_PREFERRED_PRODUCT="Civil3D"
# export AUTODESK_MCP_PREFERRED_BRIDGE="Civil3D.Bridge"

# --- Transport / reliability ----------------------------------------------
# Base reconnect delay (ms), doubles after each failed attempt.
# export AUTODESK_MCP_RECONNECT_DELAY_MS="1000"
# Max reconnect attempts before giving up (0 = retry forever).
# export AUTODESK_MCP_MAX_RECONNECT_ATTEMPTS="10"
# Per-request timeout for bridge calls (ms).
# export AUTODESK_MCP_REQUEST_TIMEOUT_MS="30000"
# health/ping heartbeat interval (ms); 0 disables.
# export AUTODESK_MCP_HEARTBEAT_INTERVAL_MS="15000"
# Endpoint registry polling interval (ms).
# export AUTODESK_MCP_ENDPOINTS_POLL_INTERVAL_MS="3000"
