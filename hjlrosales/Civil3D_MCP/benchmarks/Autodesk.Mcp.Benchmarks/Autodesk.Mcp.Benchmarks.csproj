<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Autodesk.Mcp.Benchmarks</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NuGetAudit>false</NuGetAudit>
    <Description>Self-contained performance harness for the Autodesk MCP protocol, SDK and named-pipe transport. No Autodesk references.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\sdk\Autodesk.Mcp.Sdk\Autodesk.Mcp.Sdk.csproj" />
    <ProjectReference Include="..\..\src\shared\Autodesk.Mcp.Shared\Autodesk.Mcp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
