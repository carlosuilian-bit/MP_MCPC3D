<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Civil3D.Tools.Validation</RootNamespace>
    <AssemblyName>Civil3D.Tools.Validation</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NuGetAudit>false</NuGetAudit>
    <IsPackable>false</IsPackable>
    <Description>Design validation framework and the design_validation_report workflow (Phase 7D): reusable, independently registered validation rules, the rule engine, the workflow orchestration over the domain services and the MCP tool. No Autodesk references.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\Autodesk.Mcp.Sdk\Autodesk.Mcp.Sdk.csproj" />
    <ProjectReference Include="..\..\shared\Autodesk.Mcp.Shared\Autodesk.Mcp.Shared.csproj" />
    <ProjectReference Include="..\Civil3D.Tools.Abstractions\Civil3D.Tools.Abstractions.csproj" />
    <ProjectReference Include="..\Civil3D.Tools.Workflows\Civil3D.Tools.Workflows.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain\Civil3D.Domain.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Commands\Civil3D.Domain.Commands.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Workflows\Civil3D.Domain.Workflows.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Alignments\Civil3D.Domain.Alignments.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Profiles\Civil3D.Domain.Profiles.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Surfaces\Civil3D.Domain.Surfaces.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Corridors\Civil3D.Domain.Corridors.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Pipes\Civil3D.Domain.Pipes.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Cogo\Civil3D.Domain.Cogo.csproj" />
    <ProjectReference Include="..\..\domain\Civil3D.Domain.Styles\Civil3D.Domain.Styles.csproj" />
  </ItemGroup>

</Project>
