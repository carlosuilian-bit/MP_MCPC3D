<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Civil3D.Domain</RootNamespace>
    <AssemblyName>Civil3D.Domain</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NuGetAudit>false</NuGetAudit>
    <IsPackable>false</IsPackable>
    <Description>Core Civil 3D domain layer: domain exceptions, the read-only transaction context contract, and the shared repository/service bases. Contains no Autodesk assembly references; every Autodesk API call happens inside a discipline data source implementation behind IAutodeskDocumentContext.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Civil3D.Domain.Query\Civil3D.Domain.Query.csproj" />
  </ItemGroup>

</Project>
