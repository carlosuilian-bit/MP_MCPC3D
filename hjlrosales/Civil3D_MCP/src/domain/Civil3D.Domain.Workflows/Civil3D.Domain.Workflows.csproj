<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Civil3D.Domain.Workflows</RootNamespace>
    <AssemblyName>Civil3D.Domain.Workflows</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NuGetAudit>false</NuGetAudit>
    <IsPackable>false</IsPackable>
    <Description>Reusable workflow execution framework for long-running engineering workflows (Phase 7A): workflows, steps, progress, validators, the dispatcher pipeline, timeout/cancellation and structured logging. Contains no Autodesk references and no engineering workflows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Civil3D.Domain\Civil3D.Domain.csproj" />
    <ProjectReference Include="..\Civil3D.Domain.Commands\Civil3D.Domain.Commands.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
