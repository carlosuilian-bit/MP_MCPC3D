{
  "name": "autodesk-mcp-server",
  "version": "1.0.1",
  "description": "MCP server exposing Civil3D.Bridge tools to MCP clients (Claude Desktop, Cursor, VS Code, Cline, ...) over the Autodesk MCP named-pipe protocol.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "autodesk-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "autodesk",
    "civil3d",
    "autocad",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hjlrosales/Civil3D_MCP"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build && vitest bench --config vitest.bench.config.ts",
    "prepack": "npm run typecheck && npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.17.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
